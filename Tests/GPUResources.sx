use Interop.C
use GFX.Color
use GFX.GPU

func copy_transfer_values(
    device:@GPU.Device,
    upload:@GPU.TransferBuffer,
    download:@GPU.TransferBuffer,
    byte_count:int,
) {
    var buffer = device.buffer(GPU.BufferSettings(
        size:byte_count,
        usage:GPU.BufferUsage.vertex()
    ))
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(upload, buffer, byte_count)
    transfer.download(buffer, download, byte_count)
    transfer.finish()
    var completed = commands.submit_and_track()
    completed.wait()
}

func float_from_bits(bits:uint32) float {
    var storage = bits
    let address = C.address_bits(C.mutable_pointer(storage))
    return C.load<float>(address, 0 as uint)
}

func float_bits(value:float) uint32 {
    var storage:uint32 = 0
    let address = C.address_bits(C.mutable_pointer(storage))
    let stored = C.store<float>(address, 0 as uint, value)
    return C.load<uint32>(address, 0 as uint)
}

func int8_from_bits(bits:uint8) int8 {
    var storage:uint32 = bits as uint32
    let address = C.address_bits(C.mutable_pointer(storage))
    return C.load<int8>(address, 0 as uint)
}

func int16_from_bits(bits:uint16) int16 {
    var storage:uint32 = bits as uint32
    let address = C.address_bits(C.mutable_pointer(storage))
    return C.load<int16>(address, 0 as uint)
}

func int32_from_bits(bits:uint32) int32 {
    var storage = bits
    let address = C.address_bits(C.mutable_pointer(storage))
    return C.load<int32>(address, 0 as uint)
}

func int64_from_bits(bits:uint64) int64 {
    var storage:uint = bits as uint
    let address = C.address_bits(C.mutable_pointer(storage))
    return C.load<int64>(address, 0 as uint)
}

func assert_values<T>(actual:T[], expected:T[]) {
    assert(actual.count() == expected.count())
    var index = 0
    while index < expected.count() {
        assert(actual[index] == expected[index])
        index++
    }
}

test "move bytes through a GPU buffer" {
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var upload = device.upload_buffer(8)
    var source:uint8[] = []
    source.append(3 as uint8)
    source.append(5 as uint8)
    source.append(8 as uint8)
    source.append(13 as uint8)
    source.append(21 as uint8)
    source.append(34 as uint8)
    source.append(55 as uint8)
    source.append(89 as uint8)
    upload.write(@source[0:source.count()])

    var buffer = device.buffer(GPU.BufferSettings(
        size:source.count(),
        usage:GPU.BufferUsage.vertex()
    ))
    var download = device.download_buffer(source.count())
    var commands = device.commands()
    var transfer = commands.copy()
    transfer.upload(upload, buffer, source.count())
    transfer.download(buffer, download, source.count())
    transfer.finish()
    var completed = commands.submit_and_track()
    completed.wait()

    let result = download.read()
    assert(result.count() == source.count())
    var index = 0
    while index < result.count() {
        assert(result[index] == source[index])
        index++
    }
}

test "roundtrip float32 values through a GPU buffer" {
    var device = GPU.Device(GPU.DeviceSettings(debug:true))

    var floats:float[] = [
        float_from_bits(0x8000_0000),
        float_from_bits(0x7f80_0000),
        float_from_bits(0xff80_0000),
        float_from_bits(0x7fc1_2345),
    ]
    var float_upload = device.upload_buffer(floats.count() * 4)
    float_upload.write_floats(@floats[0:floats.count()], cycle:true)
    var float_download = device.download_buffer(floats.count() * 4)
    copy_transfer_values(device, float_upload, float_download, floats.count() * 4)
    let restored_floats = float_download.read_floats()
    var float_index = 0
    while float_index < floats.count() {
        assert(float_bits(restored_floats[float_index]) == float_bits(floats[float_index]))
        float_index++
    }
}

test "roundtrip int8 values through a GPU buffer" {
    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var int8s:int8[] = [int8_from_bits(0x80), -1 as int8, 0 as int8, 127 as int8]
    var int8_upload = device.upload_buffer(int8s.count())
    int8_upload.write_int8s(@int8s[0:int8s.count()])
    var int8_download = device.download_buffer(int8s.count())
    copy_transfer_values(device, int8_upload, int8_download, int8s.count())
    let restored_int8s = int8_download.read_int8s()
    assert_values<int8>(restored_int8s, int8s)
}

