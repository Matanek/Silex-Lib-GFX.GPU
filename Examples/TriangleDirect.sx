use GFX.Color
use GFX.GPU
use GFX.Input
use GFX.Window

func main() {
    var window = Window(Window.Settings(
        title:"GFX.GPU triangle with direct APIs",
        width:960,
        height:540
    ))
    var input = Input()
    let window_id = window.id()

    var device = GPU.Device(GPU.DeviceSettings(debug:true))
    var surface = device.present(window)
    let program = GPU.ShaderProgram.hlsl(file:"Shaders/Triangle.hlsl")
    var targets:GPU.ColorTargetFormat[] = []
    targets.append(GPU.ColorTargetFormat(format:surface.format()))
    var pipeline = device.graphics_pipeline(
        program,
        GPU.GraphicsPipelineSettings(
            color_targets:targets,
            name:"GFX.GPU direct triangle"
        )
    )

    while true {
        input.wait(16)
        input.update()

        if input.is_quit_requested() || input.is_pressed(Input.Key.escape) {
            return
        }
        for event in input.events() {
            match event {
                window_close_requested(request) => {
                    if request.window == window_id { return }
                }
                else => {}
            }
        }

        var commands = device.commands()
        if var pass = commands.render(surface, Color(r:0.025, g:0.035, b:0.055, a:1.0)) {
            pass.bind(pipeline)
            pass.draw(3)
            pass.finish()
        }
        commands.submit()
    }
}
