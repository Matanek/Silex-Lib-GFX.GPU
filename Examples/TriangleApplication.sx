use GFX.Application
use GFX.GPU
use GFX.Plugins

class Triangle {
    var pipeline:GPU.GraphicsPipeline? = null
}

func render_triangle(device:@GPU.Device, surface:@GPU.Surface, triangle:&Triangle) {
    if triangle.pipeline == null {
        var targets:GPU.ColorTargetFormat[] = []
        targets.append(GPU.ColorTargetFormat(format:surface.format()))
        triangle.pipeline = device.graphics_pipeline(
            GPU.ShaderProgram.hlsl(file:"Shaders/Triangle.hlsl"),
            GPU.GraphicsPipelineSettings(color_targets:targets)
        )
    }

    var commands = device.commands()
    if var pass = commands.render(surface) {
        if let pipeline = triangle.pipeline {
            pass.bind(pipeline)
            pass.draw(3)
        }
        pass.finish()
    }
    commands.submit()
}

func main() {
    Application()
        ..add_resource(Triangle())
        ..add_plugin(Plugins.GPU())
        ..add_system(Application.Schedule.render, render_triangle)
        ..run()
}
